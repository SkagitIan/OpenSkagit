{% load static humanize %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="https://res.cloudinary.com/dfz4bhlzs/image/upload/c_thumb,w_200,g_face/v1765735577/ChatGPT_Image_Dec_14_2025_10_05_37_AM_oprqoo.png" sizes="any">
<link rel="icon" type="image/svg+xml" href="/static/img/favicon.svg">
<link rel="apple-touch-icon" href="https://res.cloudinary.com/dfz4bhlzs/image/upload/c_thumb,w_200,g_face/v1765735577/ChatGPT_Image_Dec_14_2025_10_05_37_AM_oprqoo.png">

  <title>OpenSkagit.com - AI-Enhanced Data Portal for Skagit County</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            sage: {
              50: '#f6f8f7',
              100: '#e3e9e6',
              200: '#c7d3cd',
              300: '#a4b8ad',
              400: '#7fa693',
              500: '#6b9080',
              600: '#567566',
              700: '#465e53',
              800: '#3a4e45',
              900: '#32413a',
            }
          }
        }
      }
    }
  </script>
  <link rel="stylesheet" href="{% static 'openskagit/portal.css' %}">
  <style>
    .flip-card {
  perspective: 1200px;
}

.flip-card-inner {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
}

.flip-card-face {
  position: absolute;
  inset: 0;
  backface-visibility: hidden;
}

.flip-card-front {
  transform: rotateY(0deg);
}

.flip-card-back {
  transform: rotateY(180deg);
}

  </style>
</head>
<body class="bg-gray-50">

  <!-- Header -->
  <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center py-4">
        <a href="/" class="flex items-center space-x-3 group">
          <div class="w-10 h-10 bg-gradient-to-br from-sage-500 to-sage-600 rounded-lg flex items-center justify-center shadow-md group-hover:shadow-lg transition-shadow">
            <span class="text-white font-bold text-lg">OS</span>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-bold text-gray-900">OpenSkagit.com</span>
            <span class="text-xs text-gray-600 hidden sm:block">AI-Enhanced Data Portal</span>
          </div>
        </a>
        <nav class="hidden md:flex items-center space-x-6">
          <a href="#tools" class="text-gray-700 hover:text-sage-600 transition-colors font-medium">Tools</a>
          <a href="#insights" class="text-gray-700 hover:text-sage-600 transition-colors font-medium">Insights</a>
          <a href="/api/docs/" class="text-gray-700 hover:text-sage-600 transition-colors font-medium">API</a>
          <a href="/flavor/" class="text-gray-700 hover:text-sage-600 transition-colors font-medium">Flavor Pulse</a>
          <a href="#about" class="text-gray-700 hover:text-sage-600 transition-colors font-medium">About</a>
        </nav>
      </div>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-white to-gray-50 py-16 sm:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#6b9080" stroke-width="1"/>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)" />
      </svg>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="text-center animate-fade-in-up">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 mb-6">
          Skagit <span class="gradient-text">Valley</span>. Understood.
        </h1>
        <p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
          Clear, live insights into real estate, neighborhoods, and local flavor — built for the people who live here.
        </p>

        <!-- Live Stats Counter -->
        <div class="flex flex-wrap justify-center gap-8 mb-12">
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-bold text-sage-600 stat-number" id="stat-parcels">0</div>
            <div class="text-sm text-gray-600 mt-1">Parcels Analyzed</div>
          </div>
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-bold text-sage-600 stat-number" id="stat-sales">0</div>
            <div class="text-sm text-gray-600 mt-1">Sales Analyzed</div>
          </div>
          <div class="text-center">
            <div class="text-3xl sm:text-4xl font-bold text-sage-600 stat-number" id="stat-enrichments">0</div>
            <div class="text-sm text-gray-600 mt-1">Menu Items</div>
          </div>
        </div>

        <!-- Search Bar 
        <div class="max-w-2xl mx-auto">
          <div class="relative">
            <input
              type="text"
              placeholder="Search by address, parcel number, or neighborhood..."
              class="w-full px-6 py-4 rounded-full border-2 border-gray-200 focus:border-sage-500 focus:outline-none shadow-lg text-lg"
              id="hero-search"
            />
            <button class="absolute right-2 top-1/2 -translate-y-1/2 bg-sage-600 text-white px-6 py-2 rounded-full hover:bg-sage-700 transition-colors font-medium">
              Search
            </button>
          </div>
          <p class="text-sm text-gray-500 mt-3">
            <span class="inline-flex items-center">
              <svg class="w-4 h-4 mr-1 text-sage-600" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
              </svg>
              Last updated: <span id="last-update">Loading...</span>
            </span>
          </p>
        </div>-->
          </div>
        </div>
      </div>
    </div>
  </div>
  </section>

  <!-- Featured Insights Carousel -->
  <section id="insights" class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Featured Insights</h2>
        <p class="text-gray-600">Real data from Skagit County, enhanced and analyzed</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Insight Card 1: Assessment Quality -->
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg p-8 card-hover border border-gray-100">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-gray-900">Assessment Quality</h3>
            <svg class="w-5 h-5 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
            </svg>
          </div>

          <!-- Circular Gauge -->
          <div class="flex justify-center mb-6">
            <div class="relative w-32 h-32">
              <svg class="transform -rotate-90" viewBox="0 0 120 120">
                <circle cx="60" cy="60" r="50" fill="none" stroke="#e5e7eb" stroke-width="12"/>
                <circle cx="60" cy="60" r="50" fill="none" stroke="#6b9080" stroke-width="12"
                        stroke-dasharray="314" stroke-dashoffset="94"
                        class="gauge-circle" stroke-linecap="round"/>
              </svg>
              <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-3xl font-bold text-gray-900">90%</span>
              </div>
            </div>
          </div>

          <div class="text-center">
            <div class="inline-block bg-sage-100 text-sage-800 px-3 py-1 rounded-full text-sm font-medium mb-3">
              Excellent Uniformity
            </div>
            <p class="text-sm text-gray-600">County assessments meet IAAO standards for equity</p>
          </div>
        </div>

        <!-- Insight Card 2: Market Trends -->
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg p-8 card-hover border border-gray-100">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-gray-900">Market Activity</h3>
            <svg class="w-5 h-5 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          </div>

          <!-- Mini Chart -->
          <div class="h-32 mb-6 relative">
            <svg class="w-full h-full" viewBox="0 0 200 80">
              <polyline
                points="0,60 40,50 80,45 120,35 160,30 200,25"
                fill="none"
                stroke="#6b9080"
                stroke-width="3"
                class="transition-all"
              />
              <polyline
                points="0,60 40,50 80,45 120,35 160,30 200,25 200,80 0,80"
                fill="url(#gradient)"
                opacity="0.2"
              />
              <defs>
                <linearGradient id="gradient" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%" style="stop-color:#6b9080;stop-opacity:0.8" />
                  <stop offset="100%" style="stop-color:#6b9080;stop-opacity:0" />
                </linearGradient>
              </defs>
            </svg>
          </div>

          <div class="text-center">
            <div class="text-2xl font-bold text-gray-900 mb-1">+12.4%</div>
            <p class="text-sm text-gray-600">Median home value increase this year</p>
          </div>
        </div>

        <!-- Insight Card 3: Featured Flavor Signals -->
        <div class="bg-gradient-to-br from-white to-gray-50 rounded-2xl shadow-lg border border-gray-100 p-8 card-hover">
        <div class="flip-card h-full min-h-[360px]" data-flavor-card>
          <button
            type="button"
            class="flip-trigger"
            data-flavor-flip
            aria-label="Flip flavor card"
            title="Flip flavor card"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 7v6h6"/>
              <path d="M20 17v-6h-6"/>
              <path d="M6 9a8 8 0 1011.314 11.314L20 20"/>
              <path d="M22 2v6h-6"/>
            </svg>
          </button>
          <div class="flip-card-inner h-full min-h-[360px]">
              <div class="flip-card-face flip-card-front">
                <div class="flex items-start justify-between space-x-4">
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-wide text-sage-500">
                      Featured Insight
                    </p>
                    <h3 class="text-2xl font-bold text-gray-900">
                      What’s Exciting the Valley Right Now
                    </h3>
                  </div>
                  
                </div>

                <div class="mt-6 space-y-5">
                  {% for signal in flavor_signals.top %}
                    <div class="space-y-1">
                      <p class="text-base font-semibold text-gray-900">{{ signal.dish_name|upper }}</p>
                      <p class="text-sm text-gray-500">
                        {{ signal.restaurant_name }}{% if signal.city %}, {{ signal.city }}{% endif %}
                      </p>
                      <p
                        class="text-sm text-gray-500 min-h-[1.25rem]"
                        data-flavor-message
                        data-flavor-section="top"
                        data-flavor-index="{{ forloop.counter0 }}"
                      >
                        <span
                          class="block h-3 w-24 rounded bg-gray-200 animate-pulse"
                          data-flavor-loader
                          aria-hidden="true"
                        ></span>
                      </p>

                    </div>
                  {% empty %}
                    <p class="text-sm text-gray-500">
                      Signal queue is warming up. Check back soon for new dishes.
                    </p>
                  {% endfor %}
                </div>
              </div>

              <div class="flip-card-face flip-card-back">
                <div class="flex items-start justify-between space-x-4">
                  <div>
                    <h3 class="text-xl font-bold text-gray-900">Still Finding Their Flavor</h3>
                    <p class="mt-1 text-sm text-gray-600">
                      These dishes have recent, mixed or negative feedback.
                    </p>
                  </div>
                </div>

                <div class="mt-6 space-y-5">
                  {% for signal in flavor_signals.bottom %}
                    <div class="space-y-1">
                      <p class="text-base font-semibold text-gray-900">{{ signal.dish_name|upper }}</p>
                      <p class="text-sm text-gray-500">
                        {{ signal.restaurant_name }}{% if signal.city %}, {{ signal.city }}{% endif %}
                      </p>
                      <span class="text-[0.7rem] font-semibold uppercase tracking-wide text-sage-500">
                        {{ signal.descriptor }}
                      </span>
                      <p
                        class="text-sm text-gray-500 min-h-[1.25rem]"
                        data-flavor-message
                        data-flavor-section="bottom"
                        data-flavor-index="{{ forloop.counter0 }}"
                      >
                        <span
                          class="block h-3 w-24 rounded bg-gray-200 animate-pulse"
                          data-flavor-loader
                          aria-hidden="true"
                        ></span>
                      </p>
                    </div>
                  {% empty %}
                    <p class="text-sm text-gray-500">
                      We are still listening for early hints across the valley.
                    </p>
                  {% endfor %}
                </div>

                <div class="mt-8 text-xs text-gray-500">
                  Based on recent public reviews. Signals, not rankings.
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  </section>

  <!-- County Overview Dashboard -->
  <section class="py-16 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-3">Skagit County at a Glance</h2>
        <p class="text-gray-600">Key metrics and data quality indicators</p>
      </div>

      <div class="skagit-glance-frame mx-auto mt-8 max-w-5xl">
        <div class="skagit-glance-panel">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl shadow-md p-6 card-hover">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-sage-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
              </svg>
            </div>
            <span class="text-xs font-medium text-sage-600 bg-sage-50 px-2 py-1 rounded">Live</span>
          </div>
          <div class="text-3xl font-bold text-gray-900 mb-1">{{ total_parcels|intcomma }}</div>
          <div class="text-sm text-gray-600">Total Parcels</div>
          <div class="mt-3 flex items-center text-xs text-gray-500">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
            </svg>
            Updated daily
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-md p-6 card-hover">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-sage-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
            <span class="text-xs font-medium text-green-600 bg-green-50 px-2 py-1 rounded">98%</span>
          </div>
          <div class="text-3xl font-bold text-gray-900 mb-1">{{ median_value_display }}</div>
          <div class="text-sm text-gray-600">Median Home Value</div>
          <div class="mt-3 flex items-center text-xs text-green-600">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M12 7a1 1 0 110-2h5a1 1 0 011 1v5a1 1 0 11-2 0V8.414l-4.293 4.293a1 1 0 01-1.414 0L8 10.414l-4.293 4.293a1 1 0 01-1.414-1.414l5-5a1 1 0 011.414 0L11 10.586 14.586 7H12z" clip-rule="evenodd"/>
            </svg>
            +12.4% YoY
          </div>
        </div>


        <div class="bg-white rounded-xl shadow-md p-6 card-hover">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-sage-100 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-sage-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <span class="text-xs font-medium text-sage-600 bg-sage-50 px-2 py-1 rounded">A+</span>
          </div>
          <div class="text-3xl font-bold text-gray-900 mb-1">{{ data_quality_score }}</div>
          <div class="text-sm text-gray-600">Data Quality Score</div>
          <div class="mt-3 flex items-center text-xs text-gray-500">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
              <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm9.707 5.707a1 1 0 00-1.414-1.414L9 12.586l-1.293-1.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            AI-verified
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-md p-6 card-hover">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-sage-100 rounded-lg flex items-center justify-center text-2xl">
              🍽️
            </div>
            <span class="text-xs font-medium text-sage-600 bg-sage-50 px-2 py-1 rounded">Live</span>
          </div>
          <div class="text-3xl font-bold text-gray-900 mb-1">{{ restaurant_count|intcomma }}</div>
          <div class="text-sm text-gray-600">Total Restaurants</div>
          <div class="mt-3 flex items-center text-xs text-gray-500">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm-3-7h6M8 9l1 3m2-3l-1 3m0 0H8m4 0h1" fill-rule="evenodd"/>
            </svg>
            Powered by the Gastronet pipeline
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-md p-6 card-hover">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-sage-100 rounded-lg flex items-center justify-center text-2xl p-2">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  <path d="M12 3l9 5-9 5-9-5 9-5z"/>
  <path d="M3 12l9 5 9-5"/>
  <path d="M3 16l9 5 9-5"/>
</svg>

            </div>
            <span class="text-xs font-medium text-sage-600 bg-sage-50 px-2 py-1 rounded">Live Pulse</span>
          </div>
          <div class="flex items-end gap-3">
            <div class="text-3xl font-bold text-gray-900">{{ reviews_analyzed|intcomma }}</div>
            <div class="text-right space-y-0.5">
              <div class="text-sm font-semibold text-sage-600">
                +{{ derived_enrichments_count|intcomma }}
              </div>
              <div class="text-2xs uppercase tracking-wide text-slate-400">derived enrichments</div>
            </div>
          </div>
          <div class="text-sm text-gray-600">90-Day Review Pulse</div>
          <div class="mt-3 flex items-center text-xs text-gray-500">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H8l-4 3V5z"/>
            </svg>
            Fresh, live pulse of the Skagit County restaurant industry from the last 90 days
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-md p-6 card-hover">
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 bg-sage-100 rounded-lg flex items-center justify-center text-2xl">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  <rect x="5" y="4" width="14" height="16" rx="2"/>
  <path d="M9 8h6"/>
  <path d="M9 12h6"/>
  <path d="M9 16h6"/>
</svg>

            </div>
            <span class="text-xs font-medium text-sage-600 bg-sage-50 px-2 py-1 rounded">Fresh</span>
          </div>
          <div class="text-3xl font-bold text-gray-900 mb-1">{{ menu_items_count|intcomma }}</div>
          <div class="text-sm text-gray-600">Menu Items</div>
          <div class="mt-3 flex items-center text-xs text-gray-500">
            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
              <path d="M4 5h12M4 9h12M4 13h12M4 17h12" stroke="#6b9080" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            From parsed menus and snapshots
          </div>
