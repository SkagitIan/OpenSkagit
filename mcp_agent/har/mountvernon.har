            "size": 6663,
            "mimeType": "text/html",
            "text": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xml:lang=\"en\" lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\r\n  <head>\r\n    <meta http-equiv=\"Content-Type\" content=\"text/html;charset=utf-8\" />\r\n    <meta http-equiv=\"Content-Style-Type\" content=\"text/css\" />\r\n    <meta name=\"format-detection\" content=\"telephone=no\" />\r\n\t<title>Title 2 ADMINISTRATION AND PERSONNEL</title>\r\n\t<link href=\"../../css/body.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n    \r\n    \r\n  </head>\r\n  <body>\r\n    <!--BeginNoIndex-->\r\n    <div id=\"navTop\">\r\n      <a href=\"/WA/MountVernon\">\r\n        <img src=\"../images/toc.gif\" alt=\"Home\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../MountVernon01/MountVernon0120.html\">\r\n        <img src=\"../images/prev.gif\" alt=\"Previous\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../MountVernon02/MountVernon0204.html\">\r\n        <img src=\"../images/next.gif\" alt=\"Next\" border=\"0\" />\r\n      </a>\r\n    </div>\r\n    <!--EndNoIndex-->\r\n    <div id=\"mainContent\">\r\n      <h1 class=\"Title\"><a name=\"2\"></a>Title 2<br />ADMINISTRATION AND PERSONNEL</h1>\r\n            <p class=\"ctoc\"><span class=\"bold\">Chapters:</span></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0204.html#2.04\">2.04&nbsp;&nbsp;&nbsp;&nbsp;City Offices &ndash; Days and Hours of Work</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0208.html#2.08\">2.08&nbsp;&nbsp;&nbsp;&nbsp;Mayor and Mayor Pro Tempore</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0212.html#2.12\">2.12&nbsp;&nbsp;&nbsp;&nbsp;City Council</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0224.html#2.24\">2.24&nbsp;&nbsp;&nbsp;&nbsp;City Attorney</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0228.html#2.28\">2.28&nbsp;&nbsp;&nbsp;&nbsp;City Finance Director</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0232.html#2.32\">2.32&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"italic\">Repealed</span></a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0234.html#2.34\">2.34&nbsp;&nbsp;&nbsp;&nbsp;Hearing Examiner</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0235.html#2.35\">2.35&nbsp;&nbsp;&nbsp;&nbsp;Development Services Department</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0236.html#2.36\">2.36&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"italic\">Repealed</span></a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0238.html#2.38\">2.38&nbsp;&nbsp;&nbsp;&nbsp;Public Works Director</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0240.html#2.40\">2.40&nbsp;&nbsp;&nbsp;&nbsp;Emergency Management</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0244.html#2.44\">2.44&nbsp;&nbsp;&nbsp;&nbsp;Fire Department</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0248.html#2.48\">2.48&nbsp;&nbsp;&nbsp;&nbsp;Fire Department &ndash; Civil Service Commission</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0252.html#2.52\">2.52&nbsp;&nbsp;&nbsp;&nbsp;Fire Department &ndash; Relief Fund Trustees</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0256.html#2.56\">2.56&nbsp;&nbsp;&nbsp;&nbsp;Library</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0260.html#2.60\">2.60&nbsp;&nbsp;&nbsp;&nbsp;Planning Commission</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0261.html#2.61\">2.61&nbsp;&nbsp;&nbsp;&nbsp;<span class=\"italic\">Repealed</span></a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0262.html#2.62\">2.62&nbsp;&nbsp;&nbsp;&nbsp;Public Defense Services</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0264.html#2.64\">2.64&nbsp;&nbsp;&nbsp;&nbsp;Police Department</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0268.html#2.68\">2.68&nbsp;&nbsp;&nbsp;&nbsp;Police Department &ndash; Civil Service Commission</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0272.html#2.72\">2.72&nbsp;&nbsp;&nbsp;&nbsp;Skagit County Air Pollution Control District</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0276.html#2.76\">2.76&nbsp;&nbsp;&nbsp;&nbsp;Bond of Clerk-Treasurer</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0278.html#2.78\">2.78&nbsp;&nbsp;&nbsp;&nbsp;Defense and Indemnification of City Officers, Employees, and Volunteers</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0280.html#2.80\">2.80&nbsp;&nbsp;&nbsp;&nbsp;Personnel Plan</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0282.html#2.82\">2.82&nbsp;&nbsp;&nbsp;&nbsp;Alternative Retirement Funds</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0292.html#2.92\">2.92&nbsp;&nbsp;&nbsp;&nbsp;Reimbursement of Nonelected Officials&rsquo; Expenses</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0294.html#2.94\">2.94&nbsp;&nbsp;&nbsp;&nbsp;Public Corporations</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0295.html#2.95\">2.95&nbsp;&nbsp;&nbsp;&nbsp;Real Property Acquisition, Sale, and Leasing</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0296.html#2.96\">2.96&nbsp;&nbsp;&nbsp;&nbsp;Purchasing and Contracts</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0297.html#2.97\">2.97&nbsp;&nbsp;&nbsp;&nbsp;The Mount Vernon Public Arts Commission</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0298.html#2.98\">2.98&nbsp;&nbsp;&nbsp;&nbsp;Public Records</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../MountVernon02/MountVernon0299.html#2.99\">2.99&nbsp;&nbsp;&nbsp;&nbsp;Mount Vernon Historical Commission</a></p>\r\n\r\n    </div>\r\n    <!--BeginNoIndex-->\r\n    <div id=\"navBottom\">\r\n      <a href=\"/WA/MountVernon\">\r\n        <img src=\"../images/toc.gif\" alt=\"Home\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../MountVernon01/MountVernon0120.html\">\r\n        <img src=\"../images/prev.gif\" alt=\"Previous\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../MountVernon02/MountVernon0204.html\">\r\n        <img src=\"../images/next.gif\" alt=\"Next\" border=\"0\" />\r\n      </a>\r\n    </div>\r\n    <iframe src=\"../disclaimer.html\" id=\"pgFooter\" frameborder=\"0\"></iframe>\r\n    <!--EndNoIndex-->\r\n  </body>\r\n</html>"
