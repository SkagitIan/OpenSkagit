            "size": 2930,
            "mimeType": "text/html",
            "text": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xml:lang=\"en\" lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\r\n  <head>\r\n    <meta http-equiv=\"Content-Type\" content=\"text/html;charset=utf-8\" />\r\n    <meta http-equiv=\"Content-Style-Type\" content=\"text/css\" />\r\n    <meta name=\"format-detection\" content=\"telephone=no\" />\r\n\t<title>Title 12 PUBLIC UTILITIES</title>\r\n\t<link href=\"../../css/body.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n    \r\n    \r\n  </head>\r\n  <body>\r\n    <!--BeginNoIndex-->\r\n    <div id=\"navTop\">\r\n      <a href=\"/WA/LaConner\">\r\n        <img src=\"../images/toc.gif\" alt=\"Home\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../LaConner11/LaConner1180.html\">\r\n        <img src=\"../images/prev.gif\" alt=\"Previous\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../LaConner12/LaConner1202.html\">\r\n        <img src=\"../images/next.gif\" alt=\"Next\" border=\"0\" />\r\n      </a>\r\n    </div>\r\n    <!--EndNoIndex-->\r\n    <div id=\"mainContent\">\r\n      <h1 class=\"Title\"><a name=\"12\"></a>Title 12<br />PUBLIC UTILITIES</h1>\r\n            <p class=\"Section\"><span class=\"bold\">Chapters:</span></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner12/LaConner1202.html#12.02\">12.02&nbsp;&nbsp;&nbsp;&nbsp;Infrastructure Improvements</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner12/LaConner1205.html#12.05\">12.05&nbsp;&nbsp;&nbsp;&nbsp;Sewer System</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner12/LaConner1210.html#12.10\">12.10&nbsp;&nbsp;&nbsp;&nbsp;Sewer System Rates and General Facilities Charges</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner12/LaConner1215.html#12.15\">12.15&nbsp;&nbsp;&nbsp;&nbsp;Water System</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner12/LaConner1220.html#12.20\">12.20&nbsp;&nbsp;&nbsp;&nbsp;Water System Extensions</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner12/LaConner1225.html#12.25\">12.25&nbsp;&nbsp;&nbsp;&nbsp;Cross-Connections</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner12/LaConner1230.html#12.30\">12.30&nbsp;&nbsp;&nbsp;&nbsp;Storm and Surface Water Utility</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner12/LaConner1240.html#12.40\">12.40&nbsp;&nbsp;&nbsp;&nbsp;Biosolid Composting and Green Waste Collection</a></p>\r\n\r\n    </div>\r\n    <!--BeginNoIndex-->\r\n    <div id=\"navBottom\">\r\n      <a href=\"/WA/LaConner\">\r\n        <img src=\"../images/toc.gif\" alt=\"Home\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../LaConner11/LaConner1180.html\">\r\n        <img src=\"../images/prev.gif\" alt=\"Previous\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../LaConner12/LaConner1202.html\">\r\n        <img src=\"../images/next.gif\" alt=\"Next\" border=\"0\" />\r\n      </a>\r\n    </div>\r\n    <iframe src=\"../disclaimer.html\" id=\"pgFooter\" frameborder=\"0\"></iframe>\r\n    <!--EndNoIndex-->\r\n  </body>\r\n</html>"
