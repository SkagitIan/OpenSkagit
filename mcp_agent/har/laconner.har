            "mimeType": "text/html",
            "text": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xml:lang=\"en\" lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\r\n  <head>\r\n    <meta http-equiv=\"Content-Type\" content=\"text/html;charset=utf-8\" />\r\n    <meta http-equiv=\"Content-Style-Type\" content=\"text/css\" />\r\n    <meta name=\"format-detection\" content=\"telephone=no\" />\r\n\t<title>Title 11 STREETS, SIDEWALKS, AND PUBLIC THOROUGHFARES</title>\r\n\t<link href=\"../../css/body.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n    \r\n    \r\n  </head>\r\n  <body>\r\n    <!--BeginNoIndex-->\r\n    <div id=\"navTop\">\r\n      <a href=\"/WA/LaConner\">\r\n        <img src=\"../images/toc.gif\" alt=\"Home\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../LaConner10/LaConner1010.html\">\r\n        <img src=\"../images/prev.gif\" alt=\"Previous\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../LaConner11/LaConner1105.html\">\r\n        <img src=\"../images/next.gif\" alt=\"Next\" border=\"0\" />\r\n      </a>\r\n    </div>\r\n    <!--EndNoIndex-->\r\n    <div id=\"mainContent\">\r\n      <h1 class=\"Title\"><a name=\"11\"></a>Title 11<br />STREETS, SIDEWALKS, AND PUBLIC THOROUGHFARES</h1>\r\n            <p class=\"Section\"><span class=\"bold\">Chapters:</span></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner11/LaConner1105.html#11.05\">11.05&nbsp;&nbsp;&nbsp;&nbsp;Street and Building Numbers</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner11/LaConner1107.html#11.07\">11.07&nbsp;&nbsp;&nbsp;&nbsp;Infrastructure Improvements</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner11/LaConner1110.html#11.10\">11.10&nbsp;&nbsp;&nbsp;&nbsp;Street Excavations</a></p>\r\n\r\n            <p class=\"CHTOC\"><a href=\"../LaConner11/LaConner1115.html#11.15\">11.15&nbsp;&nbsp;&nbsp;&nbsp;Local Improvements</