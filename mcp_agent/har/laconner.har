            "mimeType": "text/html",
            "text": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xml:lang=\"en\" lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\r\n  <head>\r\n    <meta http-equiv=\"Content-Type\" content=\"text/html;charset=utf-8\" />\r\n    <meta http-equiv=\"Content-Style-Type\" content=\"text/css\" />\r\n    <meta name=\"format-detection\" content=\"telephone=no\" />\r\n\t<title>Chapter 12.05 SEWER SYSTEM</title>\r\n\t\r\n   \r\n   <link href=\"../../css/body.css\" rel=\"stylesheet\" type=\"text/css\" />\r\n    \r\n    \r\n  </head>\r\n  <body>\r\n    <!--BeginNoIndex-->\r\n    <div id=\"navTop\">\r\n      <a href=\"/WA/LaConner\">\r\n        <img src=\"../images/toc.gif\" alt=\"Table of Contents\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../LaConner12/LaConner1202.html\">\r\n        <img src=\"../images/prev.gif\" alt=\"Previous\" border=\"0\" />\r\n      </a>\r\n      <a href=\"../LaConner12/LaConner1210.html\">\r\n        <img src=\"../images/next.gif\" alt=\"Next\" border=\"0\" />\r\n      </a>\r\n    </div>\r\n    <!--EndNoIndex-->\r\n    <div id=\"mainContent\">\r\n      <h2 class=\"CH\" id=\"12.05\"><a name=\"12.05\"></a>Chapter 12.05<br />SEWER SYSTEM</h2>\r\n            <p class=\"ctoc\">Sections:</p>\r\n\r\n            <p class=\"Article\">Article I.&nbsp;Definitions</p>\r\n\r\n            <p class=\"CiteTOC\"><a href=\"../LaConner12/LaConner1205.html#12.05.010\">12.05.010&nbsp;&nbsp;&nbsp;&nbsp;Above-average strength commercial customer.</a></p>\r\n\r\n            <p class=\"CiteTOC\"><a href=\"../LaConner12/LaConner1205.html#12.05.015\">12.05.015&nbsp;&nbsp;&nbsp;&nbsp;Authorized personnel.</a></p>\r\n\r\n            <p class=\"CiteTOC\"><a href=\"../LaConner12/LaConner1205.html#12.05.020\">12.05.020&nbsp;&nbsp;&nbsp;&nbsp;Availability.</a></p>\r\n\r\n            <p class=\"CiteTOC\"><a href=\"../LaConner12/LaConner120