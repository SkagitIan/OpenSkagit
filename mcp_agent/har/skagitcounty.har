            "text": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\r\n<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\r\n<html xml:lang=\"en\" lang=\"en\" xmlns=\"http://www.w3.org/1999/xhtml\">\r\n<head>\r\n<meta http-equiv='Content-Type' content='Type=text/html; charset=utf-8'>\r\n<meta name=\"format-detection\" content=\"telephone=no\" />\r\n<title>Disclaimer</title>\r\n    <link rel=\"StyleSheet\" href=\"../css/body.css\" type=\"text/css\" media=\"all\" />\r\n\r\n</head>\r\n<body>\r\n    <!--BeginNoIndex-->\r\n<p id=\"current\">The Skagit County Code is current through Ordinance O20250011, passed November 25, 2025.</p>\r\n<p id=\"disclaimer\">Disclaimer: The Clerk of the Board's Office has the official version of the Skagit County Code. Users should contact the Clerk of the Board's Office for ordinances passed subsequent to the ordinance cited above.</p>\r\n <p>Please note: in the online version of the code, definitions that appear when you mouse over or click terms with dotted underline are provided only as a tool for quick reference and may not represent the intended interpretation or application of the definitions.\r\n\r\n<p>County Website: <a href=\"https://www.skagitcounty.net/\" target=\"_top\">https://www.skagitcounty.net/</a><br />\r\nCounty Telephone: (360) 416-1300</p>\r\n<p>Codification services provided by <a href=\"https://www.generalcode.com/\" target=\"top\">General Code</a></p>\r\n    <!--EndNoIndex-->\r\n\r\n</body>\r\n</html>\r\n"
